# Copy to .env.local. Use your own Supabase project and Stripe test credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=your-endpoint-signing-secret
# Open only after migrations, webhook and the full test-mode flow are verified.
PAYMENTS_ENABLED=false
# Live keys require a separate explicit opt-in after the test-mode flow passes.
ALLOW_LIVE_PAYMENTS=false
