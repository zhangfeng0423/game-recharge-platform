# Copy to .env.local and supply your own project credentials.
# Never commit real credentials. Use Stripe test credentials for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Alternative to SUPABASE_DATABASE_URL:
# SUPABASE_POOLER_URL=postgresql://USER:PASSWORD@POOLER_HOST:PORT/DATABASE
STRIPE_SECRET_KEY=your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=your-local-webhook-signing-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
